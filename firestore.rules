rules_version = '2';
// Quy tắc bảo mật cho Firestore. Dán toàn bộ file này vào Firebase Console → Firestore Database → Rules → Publish.
// - users/{uid}: tiến độ học, chỉ chính chủ tài khoản đọc/ghi được.
// - ranking/{uid}: tên hiển thị + số bài đã hoàn thành; học viên đã đăng nhập đọc được, chỉ chính chủ ghi.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /ranking/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'done', 'updated'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
        && request.resource.data.done is int
        && request.resource.data.done >= 0 && request.resource.data.done <= 100000;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
